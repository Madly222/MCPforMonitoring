[Unit]
Description=Electric Disconnection Monitor
After=network.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/ServersMonitoringMCP
Environment="PATH=/home/user/ServersMonitoringMCP/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/user/ServersMonitoringMCP/venv/bin/python /home/user/ServersMonitoringMCP/scripts/check_electric.py

[Install]
WantedBy=multi-user.target
